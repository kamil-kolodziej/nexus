# Copy to .env and fill in values for live trading.
# Sandbox mode (NEXUS_EXCHANGE_SANDBOX=true) works without credentials.

NEXUS_EXCHANGE_API_KEY=
NEXUS_EXCHANGE_API_SECRET=
# NEXUS_EXCHANGE_ID=binance
# NEXUS_EXCHANGE_SANDBOX=true
# NEXUS_SUBSCRIBED_ASSETS=BTC/USDT
# NEXUS_LOG_ENV=production

# nexus-sentiment processor selection. Drives both the Docker build (which
# extras get installed) and the runtime processor choice. "vader" is the
# slim default; "finbert" pulls transformers + torch (~750 MB image, ~440 MB
# model on first run) and overrides config.toml [sentiment] processor_type.
# NEXUS_PROCESSOR_TYPE=vader
